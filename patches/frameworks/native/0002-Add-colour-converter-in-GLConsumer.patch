+#ifdef MTK_HARDWARE
+status_t GLConsumer::waitAuxSlotFenceLocked(size_t slotIndex) {
+    if (slotIndex >= 2) {
+        return BAD_VALUE;
+    }
+
+    AuxSlot& slot = mAuxSlots[slotIndex];
+    if (slot.fence == EGL_NO_SYNC_KHR) {
+        return NO_ERROR;
+    }
+    if (mEglDisplay == EGL_NO_DISPLAY) {
+        return INVALID_OPERATION;
+    }
+
+    EGLint result = eglClientWaitSyncKHR(
+            mEglDisplay, slot.fence, EGL_SYNC_FLUSH_COMMANDS_BIT_KHR, 1000000000);
+    // EGL_KHR_fence_sync reports a signaled fence as
+    // EGL_CONDITION_SATISFIED_KHR; EGL_ALREADY_SIGNALED_KHR is not an EGL
+    // wait result in this API.
+    if (result != EGL_CONDITION_SATISFIED_KHR) {
+        GLC_LOGE("waitAuxSlotFenceLocked: wait failed or timed out: %#x (egl=%#x)",
+                result, eglGetError());
+        return result == EGL_TIMEOUT_EXPIRED_KHR ? TIMED_OUT : UNKNOWN_ERROR;
+    }
+
+    eglDestroySyncKHR(mEglDisplay, slot.fence);
+    slot.fence = EGL_NO_SYNC_KHR;
+    return NO_ERROR;
+}
+
+status_t GLConsumer::fenceCurrentAuxTextureLocked() {
+    if (!mCurrentTextureIsAux || mCurrentAuxSlot < 0 || mCurrentAuxSlot >= 2) {
+        return NO_ERROR;
+    }
+    if (mEglDisplay == EGL_NO_DISPLAY) {
+        return INVALID_OPERATION;
+    }
+
+    AuxSlot& slot = mAuxSlots[mCurrentAuxSlot];
+    if (slot.fence != EGL_NO_SYNC_KHR) {
+        // Replace the old fence with one ordered after the latest GL use. This
+        // matters if updateTexImage was called without acquiring a new buffer.
+        eglDestroySyncKHR(mEglDisplay, slot.fence);
+        slot.fence = EGL_NO_SYNC_KHR;
+    }
+
+    slot.fence = eglCreateSyncKHR(mEglDisplay, EGL_SYNC_FENCE_KHR, NULL);
+    if (slot.fence == EGL_NO_SYNC_KHR) {
+        GLC_LOGE("fenceCurrentAuxTextureLocked: create fence failed: %#x", eglGetError());
+        return UNKNOWN_ERROR;
+    }
+    glFlush();
+    return NO_ERROR;
+}
+
+status_t GLConsumer::freeAuxSlotLocked(size_t slotIndex) {
+    if (slotIndex >= 2) {
+        return BAD_VALUE;
+    }
+
+    AuxSlot& slot = mAuxSlots[slotIndex];
+    status_t err = waitAuxSlotFenceLocked(slotIndex);
+    if (err != NO_ERROR) {
+        return err;
+    }
+
+    if (slot.image != EGL_NO_IMAGE_KHR) {
+        if (mEglDisplay == EGL_NO_DISPLAY) {
+            // Do not drop the backing GraphicBuffer while an EGLImage may
+            // still refer to it. Leave the slot intact for a later cleanup.
+            return INVALID_OPERATION;
+        }
+        if (!eglDestroyImageKHR(mEglDisplay, slot.image)) {
+            GLC_LOGW("freeAuxSlotLocked: eglDestroyImageKHR failed: %#x", eglGetError());
+        }
+        slot.image = EGL_NO_IMAGE_KHR;
+    }
+
+    slot.buffer.clear();
+    slot.ionFd = -1;
+    return NO_ERROR;
+}
