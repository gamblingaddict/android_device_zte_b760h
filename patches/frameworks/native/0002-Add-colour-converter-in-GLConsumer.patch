+static pthread_once_t gGLConsumerGrallocExtraOnce = PTHREAD_ONCE_INIT;
+static pthread_mutex_t gGLConsumerGrallocExtraMutex = PTHREAD_MUTEX_INITIALIZER;
+static GLConsumerGrallocExtraDevice* gGLConsumerGrallocExtraDevice = NULL;
