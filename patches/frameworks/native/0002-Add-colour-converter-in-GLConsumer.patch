+    hw_device_t* device = NULL;
+    err = module->methods->open(module, "extra", &device);
+    if (err != 0 || device == NULL) {
+        ALOGE("GLConsumer: unable to open gralloc extra device: %d", err);
+        gGLConsumerGrallocExtraInitStatus = err != 0 ? err : -1;
+        return;
+    }
+
+    gGLConsumerGrallocExtraDevice =
+            reinterpret_cast<GLConsumerGrallocExtraDevice*>(device);
+    if (gGLConsumerGrallocExtraDevice->getIonFd == NULL) {
+        ALOGE("GLConsumer: gralloc extra device has no getIonFd callback");
+        gGLConsumerGrallocExtraDevice = NULL;
+        gGLConsumerGrallocExtraInitStatus = -1;
+        return;
+    }
+    // The device is intentionally kept open for the process lifetime.
+    gGLConsumerGrallocExtraInitStatus = 0;
+}
+
+static status_t getGLConsumerIonFd(buffer_handle_t handle, int* outFd) {
+    if (handle == NULL || outFd == NULL) {
+        return BAD_VALUE;
+    }
+
+    int err = pthread_once(&gGLConsumerGrallocExtraOnce,
+            initGLConsumerGrallocExtra);
+    if (err != 0 || gGLConsumerGrallocExtraInitStatus != 0 ||
+            gGLConsumerGrallocExtraDevice == NULL) {
+        return NO_INIT;
+    }
+
+    int idx = -1;
+    int num = 0;
+    pthread_mutex_lock(&gGLConsumerGrallocExtraMutex);
+    err = gGLConsumerGrallocExtraDevice->getIonFd(
+            gGLConsumerGrallocExtraDevice, handle, &idx, &num);
+    pthread_mutex_unlock(&gGLConsumerGrallocExtraMutex);
+    if (err != 0) {
+        ALOGE("GLConsumer: gralloc extra getIonFd failed: %d", err);
+        return INVALID_OPERATION;
+    }
