+status_t GLConsumer::convertToAuxSlotLocked(
+        const sp<GraphicBuffer>& src, size_t slotIndex) {
+    ATRACE_CALL();
+    if (src == NULL || slotIndex >= 2 ||
+            src->getPixelFormat() != HAL_PIXEL_FORMAT_NV12_BLK) {
+        return BAD_VALUE;
+    }
+    if (src->getUsage() & GRALLOC_USAGE_PROTECTED) {
+        // Protected buffers must not be passed through this non-secure path.
+        GLC_LOGE("convertToAuxSlotLocked: protected NV12_BLK cannot use this path");
+        return INVALID_OPERATION;
+    }
+
+    AuxSlot& dst = mAuxSlots[slotIndex];
+    const uint32_t width = src->getWidth();
+    const uint32_t height = src->getHeight();
+    // DpRect and DpBlitStream's geometry arguments are signed 32-bit values.
+    // The block-format pitch convention used by this DpBlitStream version
+    // multiplies the source width by 32/16. Keep those signed arguments safe.
+    if (width == 0 || height == 0 || width > INT_MAX / 32 ||
+            height > INT_MAX) {
+        return BAD_VALUE;
+    }
+    const int32_t widthI = static_cast<int32_t>(width);
+    const int32_t heightI = static_cast<int32_t>(height);
+
+    if (dst.buffer != NULL &&
+            (dst.buffer->getWidth() != width || dst.buffer->getHeight() != height ||
+             dst.buffer->getPixelFormat() != PIXEL_FORMAT_RGBA_8888)) {
+        status_t err = freeAuxSlotLocked(slotIndex);
+        if (err != NO_ERROR) {
+            return err;
+        }
+    }
+
+    if (dst.buffer == NULL) {
+        // The blitter writes via the allocation FD; the buffer is also sampled
+        // by GL. Avoid SW usage flags so gralloc need not prefer a CPU-mappable
+        // allocation for every video frame.
+        const uint64_t usage = GRALLOC_USAGE_HW_TEXTURE | GRALLOC_USAGE_HW_2D;
+        dst.buffer = new GraphicBuffer(width, height, PIXEL_FORMAT_RGBA_8888,
+                usage, "[GLConsumer NV12_BLK conversion]");
+        if (dst.buffer == NULL || dst.buffer->initCheck() != NO_ERROR ||
+                dst.buffer->handle == NULL) {
+            GLC_LOGE("convertToAuxSlotLocked: failed to allocate RGBA buffer %ux%u",
+                    width, height);
+            dst.buffer.clear();
+            dst.ionFd = -1;
+            return NO_MEMORY;
+        }
+        dst.ionFd = -1;
+    }
+
+    if (dst.image == EGL_NO_IMAGE_KHR) {
+        EGLClientBuffer clientBuffer =
+                static_cast<EGLClientBuffer>(dst.buffer->getNativeBuffer());
+        const EGLint attrs[] = {
+            EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
+            EGL_NONE,
+        };
+        dst.image = eglCreateImageKHR(mEglDisplay, EGL_NO_CONTEXT,
+                EGL_NATIVE_BUFFER_ANDROID, clientBuffer, attrs);
+        if (dst.image == EGL_NO_IMAGE_KHR) {
+            GLC_LOGE("convertToAuxSlotLocked: eglCreateImageKHR failed: %#x", eglGetError());
+            return UNKNOWN_ERROR;
+        }
+    }
+
+    if (src->handle == NULL || dst.buffer->handle == NULL) {
+        GLC_LOGE("convertToAuxSlotLocked: missing source or destination native handle");
+        return BAD_VALUE;
+    }
+
+    int srcFd = -1;
+    status_t err = getGLConsumerIonFd(src->handle, &srcFd);
+    if (err != NO_ERROR) {
+        GLC_LOGE("convertToAuxSlotLocked: unable to get source ION FD: %d", err);
+        return err;
+    }
+    // The destination fd is owned by the aux buffer's handle and doesn't change
+    // for the buffer's lifetime, so look it up once per allocation.
+    if (dst.ionFd < 0) {
+        err = getGLConsumerIonFd(dst.buffer->handle, &dst.ionFd);
+        if (err != NO_ERROR) {
+            dst.ionFd = -1;
+            GLC_LOGE("convertToAuxSlotLocked: unable to get destination ION FD: %d", err);
+            return err;
+        }
+    }
+    const int dstFd = dst.ionFd;
+
+    const uint32_t srcStrideU = width; // MTK NV12_BLK uses the aligned width.
+    const int32_t srcStride = static_cast<int32_t>(srcStrideU);
+    const uint64_t lumaBytes64 = static_cast<uint64_t>(srcStrideU) * height;
+    if (lumaBytes64 == 0 || lumaBytes64 > UINT_MAX) {
+        return BAD_VALUE;
+    }
+    const uint32_t lumaBytes = static_cast<uint32_t>(lumaBytes64);
+    const uint32_t chromaBytes = lumaBytes / 2;
+    uint32_t srcSizes[2] = { lumaBytes, chromaBytes };
+
+    if (mBlit == NULL) {
+        mBlit = new DpBlitStream();
+    }
+    DpBlitStream& blit = *mBlit;
+    DP_STATUS_ENUM dpStatus = blit.setSrcBuffer(srcFd, srcSizes, 2);
+    if (dpStatus != DP_STATUS_RETURN_SUCCESS) {
+        GLC_LOGE("convertToAuxSlotLocked: setSrcBuffer(FD) failed: %d", dpStatus);
+        return UNKNOWN_ERROR;
+    }
+
+    DpRect srcRoi;
+    srcRoi.x = 0;
+    srcRoi.y = 0;
+    srcRoi.w = widthI;
+    srcRoi.h = heightI;
+    // Match the extended block-format config used by MTK ColorConverter.
+    dpStatus = blit.setSrcConfig(srcStride, heightI, srcStride * 32,
+            srcStride * 16, eNV12_BLK, DP_PROFILE_BT601,
+            eInterlace_None, &srcRoi, DP_SECURE_NONE, 1);
+    if (dpStatus != DP_STATUS_RETURN_SUCCESS) {
+        GLC_LOGE("convertToAuxSlotLocked: setSrcConfig failed: %d", dpStatus);
+        return UNKNOWN_ERROR;
+    }
+
+    const uint32_t dstStrideU = dst.buffer->getStride();
+    const uint32_t dstWidthU = dst.buffer->getWidth();
+    const uint32_t dstHeightU = dst.buffer->getHeight();
+    if (dstStrideU == 0 || dstStrideU > INT_MAX || dstWidthU == 0 ||
+            dstWidthU > INT_MAX || dstHeightU == 0 || dstHeightU > INT_MAX) {
+        return BAD_VALUE;
+    }
+    const int32_t dstWidth = static_cast<int32_t>(dstWidthU);
+    const int32_t dstHeight = static_cast<int32_t>(dstHeightU);
+    const uint64_t dstBytes64 = static_cast<uint64_t>(dstStrideU) *
+            dstHeightU * 4;
+    if (dstBytes64 == 0 || dstBytes64 > UINT_MAX) {
+        return BAD_VALUE;
+    }
+    uint32_t dstSizes[1] = { static_cast<uint32_t>(dstBytes64) };
+    dpStatus = blit.setDstBuffer(dstFd, dstSizes, 1);
+    if (dpStatus != DP_STATUS_RETURN_SUCCESS) {
+        GLC_LOGE("convertToAuxSlotLocked: setDstBuffer failed: %d", dpStatus);
+        return UNKNOWN_ERROR;
+    }
+
+    const uint64_t dstPitch64 = static_cast<uint64_t>(dstStrideU) * 4;
+    if (dstPitch64 == 0 || dstPitch64 > INT_MAX) {
+        return BAD_VALUE;
+    }
+    const int32_t dstPitch = static_cast<int32_t>(dstPitch64);
+    DpRect dstRoi;
+    dstRoi.x = 0;
+    dstRoi.y = 0;
+    dstRoi.w = dstWidth;
+    dstRoi.h = dstHeight;
+    dpStatus = blit.setDstConfig(dstWidth, dstHeight, dstPitch, 0,
+            eRGBA8888, DP_PROFILE_BT601, eInterlace_None, &dstRoi,
+            DP_SECURE_NONE, 1);
+    if (dpStatus != DP_STATUS_RETURN_SUCCESS) {
+        GLC_LOGE("convertToAuxSlotLocked: setDstConfig failed: %d", dpStatus);
+        return UNKNOWN_ERROR;
+    }
+
+    // invalidate() returns DP_STATUS_ENUM; DP_STATUS_RETURN_SUCCESS is zero.
+    DP_STATUS_ENUM blitStatus;
+    {
+        ATRACE_NAME("DpBlitStream::invalidate");
+        blitStatus = blit.invalidate();
+    }
+    if (blitStatus != DP_STATUS_RETURN_SUCCESS) {
+        GLC_LOGE("convertToAuxSlotLocked: DpBlitStream::invalidate failed: %d",
+                blitStatus);
+        return UNKNOWN_ERROR;
+    }
+
+    return NO_ERROR;
+}
