diff --git a/include/gui/dpframework/DpBlitStream.h b/include/gui/dpframework/DpBlitStream.h
new file mode 100644
index 0000000..4cddc31
--- /dev/null
+++ b/include/gui/dpframework/DpBlitStream.h
