+static void initGLConsumerGrallocExtra() {
+    const hw_module_t* module = NULL;
+    int err = hw_get_module(GRALLOC_HARDWARE_MODULE_ID, &module);
+    if (err != 0 || module == NULL || module->methods == NULL ||
+            module->methods->open == NULL) {
+        ALOGE("GLConsumer: unable to load gralloc module for extra device: %d", err);
+        gGLConsumerGrallocExtraInitStatus = err != 0 ? err : -1;
+        return;
