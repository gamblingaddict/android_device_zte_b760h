+    // getIonFd returns an index/count into native_handle_t::data. Validate the
+    // complete range before using the first FD for DpBlitStream's FD overload.
+    if (num < 1 || idx < 0 || idx >= handle->numFds ||
+            num > handle->numFds - idx) {
+        ALOGE("GLConsumer: invalid gralloc extra FD range idx=%d num=%d numFds=%d",
+                idx, num, handle->numFds);
+        return BAD_VALUE;
+    }
+    const int fd = handle->data[idx];
+    if (fd < 0) {
+        return BAD_VALUE;
+    }
+    *outFd = fd;
+    return NO_ERROR;
+}
