+status_t GLConsumer::bindAuxTextureImageLocked(const sp<GraphicBuffer>& src) {
+    ATRACE_CALL();
+    if (mEglDisplay == EGL_NO_DISPLAY) {
+        return INVALID_OPERATION;
+    }
+
+    // The source release fence belongs to the decoder buffer. The blitter is
+    // not a GL client, so a GPU-side eglWaitSyncKHR (what doGLFenceWaitLocked
+    // does when native fence sync is available) would not hold it back. Block
+    // the CPU until the producer is done before the blit reads the buffer.
+    status_t err = NO_ERROR;
+    if (mCurrentFence != NULL && mCurrentFence->isValid()) {
+        ATRACE_NAME("NV12_BLK source fence wait");
+        err = mCurrentFence->waitForever("GLConsumer::bindAuxTextureImageLocked");
+        if (err != NO_ERROR) {
+            GLC_LOGE("bindAuxTextureImageLocked: error waiting for source fence: %d",
+                    err);
+            return err;
+        }
+    }
+
+    // Insert a fence after the most recent use of the currently bound aux
+    // texture, including shared-buffer cases where syncForReleaseLocked may
+    // not have been called because the BufferQueue slot did not change.
+    err = fenceCurrentAuxTextureLocked();
+    if (err != NO_ERROR) {
+        return err;
+    }
+
+    const size_t dstIndex = static_cast<size_t>(mNextAuxSlot);
+    {
+        // A long wait here means the GPU is still sampling the slot we want
+        // to overwrite (consider a third aux slot if this shows up in traces).
+        ATRACE_NAME("NV12_BLK aux slot fence wait");
+        err = waitAuxSlotFenceLocked(dstIndex);
+    }
+    if (err != NO_ERROR) {
+        return err;
+    }
+
+    err = convertToAuxSlotLocked(src, dstIndex);
+    if (err != NO_ERROR) {
+        return err;
+    }
+
+    glBindTexture(mTexTarget, mTexName);
+    glEGLImageTargetTexture2DOES(mTexTarget,
+            static_cast<GLeglImageOES>(mAuxSlots[dstIndex].image));
+    GLenum glError = glGetError();
+    if (glError != GL_NO_ERROR) {
+        GLC_LOGE("bindAuxTextureImageLocked: texture bind failed: %#04x", glError);
+        return UNKNOWN_ERROR;
+    }
+
+    mCurrentAuxSlot = static_cast<int>(dstIndex);
+    mNextAuxSlot = 1 - static_cast<int>(dstIndex);
+    mCurrentTextureIsAux = true;
+    return NO_ERROR;
+}
