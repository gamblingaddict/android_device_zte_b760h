+        for (size_t i = 0; i < 2; ++i) {
+            status_t auxErr = freeAuxSlotLocked(i);
+            if (auxErr != NO_ERROR) {
+                GLC_LOGW("abandonLocked: unable to free auxiliary slot %zu: %d", i, auxErr);
