 include/gui/dpframework/DpBlitStream.h | 211 ++++++++
 include/gui/dpframework/DpDataType.h   | 376 ++++++++++++++
 libs/gui/Android.mk                    |   5 +
 libs/gui/GLConsumer.cpp                | 645 ++++++++++++++++++++++++-
 5 files changed, 1253 insertions(+), 18 deletions(-)
 create mode 100644 include/gui/dpframework/DpBlitStream.h
 create mode 100644 include/gui/dpframework/DpDataType.h

