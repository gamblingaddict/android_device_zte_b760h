From c4317a8aa98eeed8c8d46c2488361c97790050b1 Mon Sep 17 00:00:00 2001
From: gamblingaddict <112048350+gamblingaddict@users.noreply.github.com>
Date: Thu, 1 Oct 2026 18:22:26 +0700
Subject: [PATCH] Skip drawing on NV12_BLK layers

Change-Id: I64b57339faf4802e1f03e52647431b17895ea0ac
---
 services/surfaceflinger/Android.mk |  4 ++++
 services/surfaceflinger/Layer.cpp  | 12 ++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/services/surfaceflinger/Android.mk b/services/surfaceflinger/Android.mk
index 18cc946..4e45674 100644
--- a/services/surfaceflinger/Android.mk
+++ b/services/surfaceflinger/Android.mk
@@ -157,6 +157,10 @@ LOCAL_SHARED_LIBRARIES := \
     libpowermanager \
     libvulkan
 
+ifeq ($(strip $(BOARD_USES_MTK_HARDWARE)),true)
+LOCAL_CFLAGS += -DMTK_HARDWARE
+endif
+
 ifeq ($(TARGET_USES_QCOM_BSP), true)
   ifeq ($(TARGET_SUPPORTS_WEARABLES),true)
     LOCAL_C_INCLUDES += $(BOARD_DISPLAY_HAL)/libgralloc
diff --git a/services/surfaceflinger/Layer.cpp b/services/surfaceflinger/Layer.cpp
index 9114fdc..e852d85 100644
--- a/services/surfaceflinger/Layer.cpp
+++ b/services/surfaceflinger/Layer.cpp
@@ -62,6 +62,10 @@
 #define NUM_PIXEL_LOW_RES_PANEL (720*1280)
 #endif
 
+#ifdef MTK_HARDWARE
+#define HAL_PIXEL_FORMAT_NV12_BLK 0x101
+#endif
+
 #define MAX_POSITION 32767
 namespace android {
 
@@ -950,6 +954,14 @@ void Layer::onDraw(const sp<const DisplayDevice>& hw, const Region& clip,
         return;
     }
 
+#ifdef MTK_HARDWARE
+    if (mActiveBuffer != 0 &&
+        mActiveBuffer->getPixelFormat() == HAL_PIXEL_FORMAT_NV12_BLK) {
+        // Block-format video can't be imported by the GPU. Draw nothing.
+        return;
+    }
+#endif
+
     // Bind the current buffer to the GL texture, and wait for it to be
     // ready for us to draw into.
     status_t err = mSurfaceFlingerConsumer->bindTextureImage();
-- 
2.43.0

