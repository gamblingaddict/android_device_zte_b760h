# mount point	fstype    device    	[device2]

# Dumchar
/boot		emmc	/dev/bootimg	flags=display="Boot";backup=1;flashimg=1
/uboot		emmc	/dev/uboot		flags=display="Uboot";backup=1;flashimg=1
/logo		emmc	/dev/logo		flags=display="Logo";backup=1;flashimg=1
/nvram		emmc	/dev/nvram		flags=display="Nvram";backup=1;flashimg=1
/recovery	emmc	/dev/recovery	flags=display="Recovery";backup=1;flashimg=1
/ebr1   	emmc	/dev/ebr1   	flags=display="EBR1";backup=1;flashimg=1
/ebr2   	emmc	/dev/ebr2   	flags=display="EBR2";backup=1;flashimg=1
/misc	    emmc	/dev/misc		flags=display="Misc"

# System
/system		    ext4	/dev/block/mmcblk0p5    flags=display="System";backup=1
/system_image	emmc	/dev/block/mmcblk0p5	flags=display="System";backup=1;flashimg=1

# User
/cache      ext4	/dev/block/mmcblk0p3    flags=display="Cache";backup=1
/data       ext4	/dev/block/mmcblk0p6	flags=display="Data";backup=1;wipeduringfactoryreset
/unused     ext4	/dev/block/mmcblk0p7	flags=display="Unused";backup=1
/sdcard     vfat    /dev/block/mmcblk0p8	flags=display="Internal SDCard";wipeingui;storage;settingsstorage

# External storage
/external_sd	auto	/dev/block/mmcblk1p1	/dev/block/mmcblk1	flags=display="External SDCard";storage;wipeingui;removable;backup=0
/usbotg         auto    /dev/block/sda1         /dev/block/sda		flags=display="USB";storage;removable;backup=0